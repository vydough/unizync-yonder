+function renderPostInterestChips() {
+  const el = $('post-interest-chips');
+  if (!el) return;
+  el.innerHTML = allInterests.map((i) => {
+    const id = String(i.id);
+    return `<button type="button" class="chip" data-post-interest="${esc(id)}" aria-pressed="${postInterestIds.includes(id)}">${esc(i.emoji || '')} ${esc(i.label)}</button>`;
+  }).join('');
+  el.querySelectorAll('[data-post-interest]').forEach((button) => {
+    button.addEventListener('click', () => {
+      const id = String(button.dataset.postInterest);
+      if (postInterestIds.includes(id)) postInterestIds = postInterestIds.filter((x) => x !== id);
+      else postInterestIds.push(id);
+      renderPostInterestChips();
